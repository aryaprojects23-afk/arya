# HarvestLink 2.0 Configuration
# Government Agricultural Market Data Integration & Multilingual Marketplace

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=harvestlink-secret-key-change-in-production-2026

# Government of India Open Data Platform (OGD / AGMARKNET)
# Register at https://data.gov.in to obtain an official API key
# Resource: Current Daily Price of Various Commodities from Various Markets (Mandi)
OGD_API_KEY=
GOV_DATA_API_BASE=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
GOV_SYNC_INTERVAL_HOURS=6
GOV_REQUEST_TIMEOUT_SECONDS=15
GOV_MAX_RETRIES=3

# Database
DATABASE_URL=sqlite:///./harvestlink.db

# Demonstration & Default Region (Andhra Pradesh, Chittoor Mandi)
DEFAULT_STATE=Andhra Pradesh
DEFAULT_DISTRICT=Chittoor
